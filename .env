# ============================================
# FleetTracker - Environment Configuration
# ============================================
# Switch between local Docker and remote hosted services by changing
# the VITE_* URLs. The Docker vars only matter when running compose.

# ── Mode ────────────────────────────────────
# "docker"  → ES + GeoServer run in compose (default)
# "remote"  → point VITE_* URLs to your hosted instances
DEPLOY_MODE=docker

# ── Elasticsearch (Docker) ──────────────────
ELASTIC_VERSION=9.0.0
ELASTIC_MEM_LIMIT=2g
ELASTIC_SECURITY_ENABLED=false
ELASTIC_CLUSTER_NAME=mtl-fleet
ELASTIC_PASSWORD=your_secure_password_123
ELASTIC_PORT=9200

# ── GeoServer (Docker) ─────────────────────
GEOSERVER_VERSION=2.26.1
GEOSERVER_PORT=8080
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=geoserver
GEOSERVER_MEM_XMS=512m
GEOSERVER_MEM_XMX=2g
GEOSERVER_DATA_DIR=/opt/geoserver/data_dir
GEOSERVER_CORS_ENABLED=true

# ── Frontend (Docker) ──────────────────────
FRONTEND_PORT=5173

# ── Frontend runtime URLs ──────────────────
# These are injected into the Vite app at build/dev time.
# For Docker:  use the proxy paths (default, no change needed)
# For remote:  set the full URL to your hosted services
#
# Examples:
#   Local Docker (default):
#     VITE_ES_BASE_URL=/api/es
#     VITE_GEOSERVER_BASE_URL=/api/geoserver
#
#   Remote hosted:
#     VITE_ES_BASE_URL=https://es.myfleet.example.com
#     VITE_GEOSERVER_BASE_URL=https://geoserver.myfleet.example.com/geoserver

#VITE_ES_BASE_URL=http://elasticsearch:9200/
#VITE_GEOSERVER_BASE_URL=http://geoserver:8080/geoserver/
#VITE_TILESERVER_BASE_URL=https://tiles.openfreemap.org/
VITE_ES_BASE_URL=https://elastic.mtl.colbert.fr:9200
VITE_GEOSERVER_BASE_URL=https://geoserver.mtl.colbert.fr/geoserver
VITE_TILESERVER_BASE_URL=https://maps.mtl.colbert.fr

VITE_ES_API_KEY=
# ── TileServer GL (Docker) ───────────────
TILESERVER_PORT=8081

# ── Map tile style ─────────────────────────
# Style NAME from TileServer GL (resolved as {TILESERVER}/styles/{NAME}/style.json)
# Leave unset to fall back to OpenFreeMap dark
VITE_MAP_STYLE=leviathan

# ── Network ────────────────────────────────
COMPOSE_PROJECT_NAME=fleettracker
